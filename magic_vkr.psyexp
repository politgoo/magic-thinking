        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="keys = event.getKeys(keyList=['left', 'right', 'space', '1', '2', '3', '4', '5', '6', '7'])&amp;#10;for k in keys:&amp;#10;    if k in ['1', '2', '3', '4', '5', '6', '7']:&amp;#10;        resp = int(k)&amp;#10;    elif k == 'left':&amp;#10;        resp = 4 if resp is None else max(1, resp - 1)&amp;#10;    elif k == 'right':&amp;#10;        resp = 4 if resp is None else min(7, resp + 1)&amp;#10;    elif k == 'space' and resp is not None:&amp;#10;        continueRoutine = False&amp;#10;    if resp is not None:&amp;#10;        tob_slider_before.markerPos = resp&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="var keys = psychoJS.eventManager.getKeys({keyList: ['left', 'right', 'space', '1', '2', '3', '4', '5', '6', '7']});&amp;#10;for (var i = 0; i &lt; keys.length; i++) {&amp;#10;  var k = keys[i];&amp;#10;  if (['1','2','3','4','5','6','7'].indexOf(k) &gt;= 0) { resp = parseInt(k); }&amp;#10;  else if (k === 'left') { resp = (resp === null) ? 4 : Math.max(1, resp - 1); }&amp;#10;  else if (k === 'right') { resp = (resp === null) ? 4 : Math.min(7, resp + 1); }&amp;#10;  else if (k === 'space' &amp;&amp; resp !== null) { continueRoutine = false; }&amp;#10;  if (resp !== null) { tob_slider_before.setMarkerPos(resp); }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="tob_resp[Number(item_n)] = resp;&amp;#10;psychoJS.experiment.addData('tob_' + String(item_n), resp);&amp;#10;psychoJS.experiment.addData('tob_rt_' + String(item_n), t);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="tob_resp[int(item_n)] = resp&amp;#10;thisExp.addData('tob_' + str(item_n), resp)&amp;#10;thisExp.addData('tob_rt_' + str(item_n), t)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_tob_before" valType="code" updates="None" name="name"/>
      </CodeComponent>
