        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="control_resp = ''; control_rt = -1; end_at = null;&amp;#10;psychoJS.eventManager.clearEvents();&amp;#10;_rm = new core.Mouse({win: psychoJS.window});&amp;#10;_m0 = _rm.getPos().slice();&amp;#10;_move_t = -1; _method = ''; _blur0 = blur_count;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="control_resp = ''&amp;#10;control_rt = -1&amp;#10;end_at = None&amp;#10;event.clearEvents()&amp;#10;_rm = event.Mouse(win=win)&amp;#10;_m0 = list(_rm.getPos())&amp;#10;_move_t = -1&amp;#10;_method = ''&amp;#10;_blur0 = blur_count&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="if _move_t &lt; 0:&amp;#10;    _mp = _rm.getPos()&amp;#10;    if abs(_mp[0] - _m0[0]) &gt; 0.005 or abs(_mp[1] - _m0[1]) &gt; 0.005:&amp;#10;        _move_t = t&amp;#10;if end_at is None:&amp;#10;    keys = event.getKeys(keyList=['left', 'right'])&amp;#10;    if 'left' in keys or btn_control_q_l.numClicks &gt; 0:&amp;#10;        control_resp = 'ceiling'; control_rt = t; end_at = t + 0.35&amp;#10;        _method = 'key' if 'left' in keys else 'mouse'&amp;#10;        btn_control_q_l.fillColor = 'goldenrod'&amp;#10;    elif 'right' in keys or btn_control_q_r.numClicks &gt; 0:&amp;#10;        control_resp = 'no_ceiling'; control_rt = t; end_at = t + 0.35&amp;#10;        _method = 'key' if 'right' in keys else 'mouse'&amp;#10;        btn_control_q_r.fillColor = 'goldenrod'&amp;#10;elif t &gt;= end_at:&amp;#10;    continueRoutine = False&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (_move_t &lt; 0) {&amp;#10;  var _mp = _rm.getPos();&amp;#10;  if (Math.abs(_mp[0] - _m0[0]) &gt; 0.005 || Math.abs(_mp[1] - _m0[1]) &gt; 0.005) { _move_t = t; }&amp;#10;}&amp;#10;if (end_at === null) {&amp;#10;  var keys = psychoJS.eventManager.getKeys({keyList: ['left', 'right']});&amp;#10;  if (keys.indexOf('left') &gt;= 0 || btn_control_q_l.numClicks &gt; 0) {&amp;#10;    control_resp = 'ceiling'; control_rt = t; end_at = t + 0.35;&amp;#10;    _method = (keys.indexOf('left') &gt;= 0) ? 'key' : 'mouse';&amp;#10;    btn_control_q_l.setFillColor(new util.Color('goldenrod'));&amp;#10;  } else if (keys.indexOf('right') &gt;= 0 || btn_control_q_r.numClicks &gt; 0) {&amp;#10;    control_resp = 'no_ceiling'; control_rt = t; end_at = t + 0.35;&amp;#10;    _method = (keys.indexOf('right') &gt;= 0) ? 'key' : 'mouse';&amp;#10;    btn_control_q_r.setFillColor(new util.Color('goldenrod'));&amp;#10;  }&amp;#10;} else if (t &gt;= end_at) {&amp;#10;  continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData('control_resp', control_resp);&amp;#10;psychoJS.experiment.addData('control_rt', control_rt);&amp;#10;psychoJS.experiment.addData('control_q_method', _method);&amp;#10;psychoJS.experiment.addData('control_q_first_move', _move_t);&amp;#10;psychoJS.experiment.addData('control_q_blur', blur_count - _blur0);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('control_resp', control_resp)&amp;#10;thisExp.addData('control_rt', control_rt)&amp;#10;thisExp.addData('control_q_method', _method)&amp;#10;thisExp.addData('control_q_first_move', _move_t)&amp;#10;thisExp.addData('control_q_blur', blur_count - _blur0)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
