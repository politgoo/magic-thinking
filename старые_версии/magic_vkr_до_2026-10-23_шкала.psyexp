      <CodeComponent name="code_rating" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="TXT_RATING_HINT = 'Отметьте ответ на обеих шкалах (щёлкните по шкале), затем нажмите «Готово».'&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="TXT_RATING_HINT = &quot;Отметьте ответ на обеих шкалах (щёлкните по шкале), затем нажмите «Готово».&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="rating_clicks = 0; rating_tries = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="rating_clicks = 0&amp;#10;rating_tries = 0&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="if rating_done.numClicks &gt; rating_clicks:&amp;#10;    rating_clicks = rating_done.numClicks&amp;#10;    rating_tries += 1&amp;#10;    if importance.getRating() is not None and control.getRating() is not None:&amp;#10;        continueRoutine = False&amp;#10;    else:&amp;#10;        rating_text.text = TXT_RATING_HINT&amp;#10;        rating_text.color = 'gold'&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (rating_done.numClicks &gt; rating_clicks) {&amp;#10;  rating_clicks = rating_done.numClicks;&amp;#10;  rating_tries += 1;&amp;#10;  var _ri = importance.getRating(), _rc = control.getRating();&amp;#10;  if (_ri !== undefined &amp;&amp; _ri !== null &amp;&amp; _rc !== undefined &amp;&amp; _rc !== null) { continueRoutine = false; }&amp;#10;  else { rating_text.setText(TXT_RATING_HINT); rating_text.setColor(new util.Color('gold')); }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="psychoJS.experiment.addData('rating_time', t);&amp;#10;psychoJS.experiment.addData('rating_tries', rating_tries);&amp;#10;psychoJS.experiment.addData('importance_rating', importance.getRating());&amp;#10;psychoJS.experiment.addData('control_rating', control.getRating());&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="thisExp.addData('rating_time', t)&amp;#10;thisExp.addData('rating_tries', rating_tries)&amp;#10;thisExp.addData('importance_rating', importance.getRating())&amp;#10;thisExp.addData('control_rating', control.getRating())&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_rating" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
