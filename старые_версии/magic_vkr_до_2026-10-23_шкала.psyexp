      <CodeComponent name="code_effort" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="RU_ALPHA = 'абвгдежзийклмнопрстуфхцчшщъыьэюя'&amp;#10;def _lev(a, b):&amp;#10;    prev = list(range(len(b) + 1))&amp;#10;    for i, ca in enumerate(a, 1):&amp;#10;        cur = [i]&amp;#10;        for j, cb in enumerate(b, 1):&amp;#10;            cur.append(min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (0 if ca == cb else 1)))&amp;#10;        prev = cur&amp;#10;    return prev[-1]&amp;#10;def check_alpha(s, want_upper):&amp;#10;    # возвращает: статус (empty/typed), число букв, проходы (букв / 32), целое число проходов,&amp;#10;    # процент правильности, расстояние до эталона, доля прописных&amp;#10;    letters = ''.join(ch for ch in (s or '') if ch.isalpha())&amp;#10;    if not letters:&amp;#10;        return ('empty', 0, 0.0, 0, 0.0, -1, 0.0)&amp;#10;    upper = 100.0 * sum(1 for ch in letters if ch.isupper()) / len(letters)&amp;#10;    low = letters.lower().replace('ё', '')&amp;#10;    n = len(low)&amp;#10;    passes = n / float(len(RU_ALPHA))&amp;#10;    k = max(1, int(passes + 0.5))  # округление как Math.round в JS&amp;#10;    k_cmp = min(k, 20)&amp;#10;    target = RU_ALPHA * k_cmp&amp;#10;    d = _lev(low[:len(target) + 32], target)&amp;#10;    acc = max(0.0, 100.0 * (1.0 - d / float(len(target))))&amp;#10;    return ('typed', len(letters), passes, k, acc, d, upper)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="RU_ALPHA = 'абвгдежзийклмнопрстуфхцчшщъыьэюя';&amp;#10;_lev = function(a, b) {&amp;#10;  var prev = []; for (var j = 0; j &lt;= b.length; j++) { prev.push(j); }&amp;#10;  for (var i = 1; i &lt;= a.length; i++) {&amp;#10;    var cur = [i];&amp;#10;    for (var j2 = 1; j2 &lt;= b.length; j2++) {&amp;#10;      cur.push(Math.min(prev[j2] + 1, cur[j2 - 1] + 1, prev[j2 - 1] + ((a[i - 1] === b[j2 - 1]) ? 0 : 1)));&amp;#10;    }&amp;#10;    prev = cur;&amp;#10;  }&amp;#10;  return prev[b.length];&amp;#10;};&amp;#10;check_alpha = function(s, want_upper) {&amp;#10;  var letters = (s || '').replace(/[^A-Za-zА-Яа-яЁё]/g, '');&amp;#10;  if (letters.length === 0) { return ['empty', 0, 0.0, 0, 0.0, -1, 0.0]; }&amp;#10;  var nUp = 0; for (var q = 0; q &lt; letters.length; q++) { var ch = letters[q]; if (ch !== ch.toLowerCase()) { nUp += 1; } }&amp;#10;  var upper = 100.0 * nUp / letters.length;&amp;#10;  var low = letters.toLowerCase().replace(/ё/g, '');&amp;#10;  var n = low.length;&amp;#10;  var passes = n / RU_ALPHA.length;&amp;#10;  var k = Math.max(1, Math.round(passes));&amp;#10;  var kCmp = Math.min(k, 20);&amp;#10;  var target = ''; for (var r = 0; r &lt; kCmp; r++) { target += RU_ALPHA; }&amp;#10;  var d = _lev(low.slice(0, target.length + 32), target);&amp;#10;  var acc = Math.max(0.0, 100.0 * (1.0 - d / target.length));&amp;#10;  return ['typed', letters.length, passes, k, acc, d, upper];&amp;#10;};&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="effort_clicks = 0; effort_attempts = 0; effort_res = ['empty', 0, 0.0, 0, 0.0, -1, 0.0]; effort_start = -1; effort_last = -1; effort_prev = ''; effort_attempt_times = []; effort_del = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="effort_clicks = 0&amp;#10;effort_attempts = 0&amp;#10;effort_res = ('empty', 0, 0.0, 0, 0.0, -1, 0.0)&amp;#10;effort_start = -1&amp;#10;effort_last = -1&amp;#10;effort_prev = ''&amp;#10;effort_attempt_times = []&amp;#10;effort_del = 0&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="_cur = effort_box.text or ''&amp;#10;if _cur != effort_prev:&amp;#10;    if len(_cur) &lt; len(effort_prev):&amp;#10;        effort_del += 1&amp;#10;    effort_prev = _cur&amp;#10;    effort_last = t&amp;#10;    if effort_start &lt; 0:&amp;#10;        effort_start = t&amp;#10;if effort_done.numClicks &gt; effort_clicks:&amp;#10;    effort_clicks = effort_done.numClicks&amp;#10;    effort_attempts += 1&amp;#10;    effort_attempt_times.append(round(t, 3))&amp;#10;    effort_res = check_alpha(effort_box.text, True)&amp;#10;    continueRoutine = False&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="var _cur = effort_box.text || '';&amp;#10;if (_cur !== effort_prev) { if (_cur.length &lt; effort_prev.length) { effort_del += 1; } effort_prev = _cur; effort_last = t; if (effort_start &lt; 0) { effort_start = t; } }&amp;#10;if (effort_done.numClicks &gt; effort_clicks) {&amp;#10;  effort_clicks = effort_done.numClicks;&amp;#10;  effort_attempts += 1;&amp;#10;  effort_attempt_times.push(Math.round(t * 1000) / 1000);&amp;#10;  effort_res = check_alpha(effort_box.text, true);&amp;#10;  continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="var txt = effort_box.text || '';&amp;#10;psychoJS.experiment.addData('effort_text', txt);&amp;#10;psychoJS.experiment.addData('effort_len', txt.length);&amp;#10;psychoJS.experiment.addData('effort_status', effort_res[0]);&amp;#10;psychoJS.experiment.addData('effort_letters', effort_res[1]);&amp;#10;psychoJS.experiment.addData('effort_passes', Math.round(effort_res[2] * 100) / 100);&amp;#10;psychoJS.experiment.addData('effort_times', effort_res[3]);&amp;#10;psychoJS.experiment.addData('effort_acc_pct', Math.round(effort_res[4] * 10) / 10);&amp;#10;psychoJS.experiment.addData('effort_dist', effort_res[5]);&amp;#10;psychoJS.experiment.addData('effort_upper_pct', Math.round(effort_res[6] * 10) / 10);&amp;#10;psychoJS.experiment.addData('effort_attempts', effort_attempts);&amp;#10;psychoJS.experiment.addData('effort_start', effort_start);&amp;#10;psychoJS.experiment.addData('effort_last_key', effort_last);&amp;#10;psychoJS.experiment.addData('effort_typing', (effort_start &gt;= 0) ? (effort_last - effort_start) : -1);&amp;#10;psychoJS.experiment.addData('effort_attempt_times', effort_attempt_times.join(';'));&amp;#10;psychoJS.experiment.addData('effort_deletions', effort_del);&amp;#10;psychoJS.experiment.addData('effort_time', t);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="txt = effort_box.text or ''&amp;#10;thisExp.addData('effort_text', txt)&amp;#10;thisExp.addData('effort_len', len(txt))&amp;#10;thisExp.addData('effort_status', effort_res[0])&amp;#10;thisExp.addData('effort_letters', effort_res[1])&amp;#10;thisExp.addData('effort_passes', round(effort_res[2], 2))&amp;#10;thisExp.addData('effort_times', effort_res[3])&amp;#10;thisExp.addData('effort_acc_pct', round(effort_res[4], 1))&amp;#10;thisExp.addData('effort_dist', effort_res[5])&amp;#10;thisExp.addData('effort_upper_pct', round(effort_res[6], 1))&amp;#10;thisExp.addData('effort_attempts', effort_attempts)&amp;#10;thisExp.addData('effort_start', effort_start)&amp;#10;thisExp.addData('effort_last_key', effort_last)&amp;#10;thisExp.addData('effort_typing', (effort_last - effort_start) if effort_start &gt;= 0 else -1)&amp;#10;thisExp.addData('effort_attempt_times', ';'.join(str(x) for x in effort_attempt_times))&amp;#10;thisExp.addData('effort_deletions', effort_del)&amp;#10;thisExp.addData('effort_time', t)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
