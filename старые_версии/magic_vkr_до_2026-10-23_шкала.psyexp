      <CodeComponent name="code_choice" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="TXT_CHOICE_EASY = 'А сейчас бонус за участие. Многие древние мистические учения утверждают, что мысли могут влиять на будущее. Вы можете повысить вероятность того, что что-то хорошее для вас произойдёт в ближайшее время, совершив простой выбор: нажать на кнопку «Магия» или, если не хотите воспользоваться этой возможностью, нажать на кнопку «Пропустить» и перейти к следующему этапу.'&amp;#10;TXT_CHOICE_HARD = 'А сейчас бонус за участие. Многие мистические учения утверждают, что мысли могут влиять на будущее, но их влияние зависит от приложенных усилий. Вы можете повысить вероятность того, что что-то хорошее для вас произойдёт в ближайшее время, нажав на кнопку «Магия» и напечатав в появившемся поле алфавит один раз, или на кнопку «Пропустить» и перейти к следующему этапу.'&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="TXT_CHOICE_EASY = &quot;А сейчас бонус за участие. Многие древние мистические учения утверждают, что мысли могут влиять на будущее. Вы можете повысить вероятность того, что что-то хорошее для вас произойдёт в ближайшее время, совершив простой выбор: нажать на кнопку «Магия» или, если не хотите воспользоваться этой возможностью, нажать на кнопку «Пропустить» и перейти к следующему этапу.&quot;;&amp;#10;TXT_CHOICE_HARD = &quot;А сейчас бонус за участие. Многие мистические учения утверждают, что мысли могут влиять на будущее, но их влияние зависит от приложенных усилий. Вы можете повысить вероятность того, что что-то хорошее для вас произойдёт в ближайшее время, нажав на кнопку «Магия» и напечатав в появившемся поле алфавит один раз, или на кнопку «Пропустить» и перейти к следующему этапу.&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="instr_txt = (cost === 'hard') ? TXT_CHOICE_HARD : TXT_CHOICE_EASY;&amp;#10;hist_update('c');&amp;#10;choice_resp = ''; choice_rt = -1; end_at = null;&amp;#10;psychoJS.eventManager.clearEvents();&amp;#10;_rm = new core.Mouse({win: psychoJS.window});&amp;#10;_m0 = _rm.getPos().slice();&amp;#10;_move_t = -1; _method = ''; _blur0 = blur_count;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="instr_txt = TXT_CHOICE_HARD if cost == 'hard' else TXT_CHOICE_EASY&amp;#10;choice_resp = ''&amp;#10;choice_rt = -1&amp;#10;end_at = None&amp;#10;event.clearEvents()&amp;#10;_rm = event.Mouse(win=win)&amp;#10;_m0 = list(_rm.getPos())&amp;#10;_move_t = -1&amp;#10;_method = ''&amp;#10;_blur0 = blur_count&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="if _move_t &lt; 0:&amp;#10;    _mp = _rm.getPos()&amp;#10;    if abs(_mp[0] - _m0[0]) &gt; 0.005 or abs(_mp[1] - _m0[1]) &gt; 0.005:&amp;#10;        _move_t = t&amp;#10;if end_at is None:&amp;#10;    keys = event.getKeys(keyList=['left', 'right'])&amp;#10;    if 'left' in keys or btn_choice_l.numClicks &gt; 0:&amp;#10;        choice_resp = 'magic'; choice_rt = t; end_at = t + 0.35&amp;#10;        _method = 'key' if 'left' in keys else 'mouse'&amp;#10;        btn_choice_l.fillColor = 'goldenrod'&amp;#10;    elif 'right' in keys or btn_choice_r.numClicks &gt; 0:&amp;#10;        choice_resp = 'skip'; choice_rt = t; end_at = t + 0.35&amp;#10;        _method = 'key' if 'right' in keys else 'mouse'&amp;#10;        btn_choice_r.fillColor = 'goldenrod'&amp;#10;elif t &gt;= end_at:&amp;#10;    continueRoutine = False&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (_move_t &lt; 0) {&amp;#10;  var _mp = _rm.getPos();&amp;#10;  if (Math.abs(_mp[0] - _m0[0]) &gt; 0.005 || Math.abs(_mp[1] - _m0[1]) &gt; 0.005) { _move_t = t; }&amp;#10;}&amp;#10;if (end_at === null) {&amp;#10;  var keys = psychoJS.eventManager.getKeys({keyList: ['left', 'right']});&amp;#10;  if (keys.indexOf('left') &gt;= 0 || btn_choice_l.numClicks &gt; 0) {&amp;#10;    choice_resp = 'magic'; choice_rt = t; end_at = t + 0.35;&amp;#10;    _method = (keys.indexOf('left') &gt;= 0) ? 'key' : 'mouse';&amp;#10;    btn_choice_l.setFillColor(new util.Color('goldenrod'));&amp;#10;  } else if (keys.indexOf('right') &gt;= 0 || btn_choice_r.numClicks &gt; 0) {&amp;#10;    choice_resp = 'skip'; choice_rt = t; end_at = t + 0.35;&amp;#10;    _method = (keys.indexOf('right') &gt;= 0) ? 'key' : 'mouse';&amp;#10;    btn_choice_r.setFillColor(new util.Color('goldenrod'));&amp;#10;  }&amp;#10;} else if (t &gt;= end_at) {&amp;#10;  continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="nEffort = (choice_resp === 'magic' &amp;&amp; cost === 'hard') ? 1 : 0;&amp;#10;psychoJS.experiment.addData('choice', choice_resp);&amp;#10;psychoJS.experiment.addData('choice_rt', choice_rt);&amp;#10;psychoJS.experiment.addData('choice_method', _method);&amp;#10;psychoJS.experiment.addData('choice_first_move', _move_t);&amp;#10;psychoJS.experiment.addData('choice_blur', blur_count - _blur0);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="nEffort = 1 if (choice_resp == 'magic' and cost == 'hard') else 0&amp;#10;thisExp.addData('choice', choice_resp)&amp;#10;thisExp.addData('choice_rt', choice_rt)&amp;#10;thisExp.addData('choice_method', _method)&amp;#10;thisExp.addData('choice_first_move', _move_t)&amp;#10;thisExp.addData('choice_blur', blur_count - _blur0)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_choice" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <TextComponent name="choice_instr" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
