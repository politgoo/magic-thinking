    <Param val="{'имя|req': '', 'пол|req': ['женский', 'мужской', 'не указывать'], 'возраст|req': ''}" valType="code" updates="None" name="Experiment info"/>
    <Param val="True" valType="bool" updates="None" name="Force stereo"/>
