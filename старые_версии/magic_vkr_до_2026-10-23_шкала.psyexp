      <CodeComponent name="code_tob_after" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="resp = null;&amp;#10;sliderSeen = null;&amp;#10;keyI = 0;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="resp = None&amp;#10;slider_seen = None&amp;#10;key_i = 0&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="_r = tob_slider_after.getRating()&amp;#10;if _r is not None and _r != slider_seen:&amp;#10;    slider_seen = _r&amp;#10;    resp = int(round(_r))&amp;#10;while key_i &lt; len(_tob_key_after_allKeys):&amp;#10;    _k = _tob_key_after_allKeys[key_i].name&amp;#10;    key_i += 1&amp;#10;    if _k in ['1', '2', '3', '4', '5', '6', '7']:&amp;#10;        resp = int(_k)&amp;#10;    elif _k == 'left':&amp;#10;        resp = 4 if resp is None else max(1, resp - 1)&amp;#10;    elif _k == 'right':&amp;#10;        resp = 4 if resp is None else min(7, resp + 1)&amp;#10;    elif _k == 'space' and resp is not None:&amp;#10;        continueRoutine = False&amp;#10;if resp is not None:&amp;#10;    tob_slider_after.markerPos = resp&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="var _r = tob_slider_after.getRating();&amp;#10;if (typeof _r !== 'undefined' &amp;&amp; _r !== null &amp;&amp; _r !== sliderSeen) {&amp;#10;  sliderSeen = _r;&amp;#10;  resp = Math.round(_r);&amp;#10;}&amp;#10;while (keyI &lt; _tob_key_after_allKeys.length) {&amp;#10;  var _k = _tob_key_after_allKeys[keyI].name;&amp;#10;  keyI += 1;&amp;#10;  if (['1','2','3','4','5','6','7'].indexOf(_k) &gt;= 0) { resp = parseInt(_k); }&amp;#10;  else if (_k === 'left') { resp = ((resp === null) || (typeof resp === 'undefined')) ? 4 : Math.max(1, resp - 1); }&amp;#10;  else if (_k === 'right') { resp = ((resp === null) || (typeof resp === 'undefined')) ? 4 : Math.min(7, resp + 1); }&amp;#10;  else if (_k === 'space' &amp;&amp; resp !== null &amp;&amp; typeof resp !== 'undefined') { continueRoutine = false; }&amp;#10;}&amp;#10;if (resp !== null &amp;&amp; typeof resp !== 'undefined') { tob_slider_after.setMarkerPos(resp); }&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="tob_resp[Number(item_n)] = resp;&amp;#10;psychoJS.experiment.addData('tob_' + String(item_n), resp);&amp;#10;psychoJS.experiment.addData('tob_rt_' + String(item_n), t);&amp;#10;psychoJS.experiment.addData('tob_keys_' + String(item_n), keyI);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
