        <Param val="LTR" valType="str" updates="None" name="languageStyle"/>
        <Param val="0.031" valType="num" updates="constant" name="letterHeight"/>
        <Param val="thanks_text" valType="code" updates="None" name="name"/>
        <Param val="" valType="num" updates="constant" name="opacity"/>
        <Param val="0" valType="num" updates="constant" name="ori"/>
        <Param val="(0, 0)" valType="list" updates="constant" name="pos"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="None" name="startEstim"/>
        <Param val="time (s)" valType="str" updates="None" name="startType"/>
        <Param val="0.0" valType="code" updates="None" name="startVal"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Спасибо за участие!&amp;#10;&amp;#10;Кнопка «Магия» не влияет на события: она использовалась, чтобы изучить, как люди принимают решения в ситуации неопределённости. Если вам предлагалось напечатать алфавит, это задание измеряло готовность прилагать усилия.&amp;#10;&amp;#10;Нажмите пробел, чтобы завершить." valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="1.4" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <CodeComponent name="code_datapipe" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="TXT_THANKS_BASE = &quot;Спасибо за участие!\n\nКнопка «Магия» не влияет на события: она использовалась, чтобы изучить, как люди принимают решения в ситуации неопределённости. Если вам предлагалось напечатать алфавит, это задание измеряло готовность прилагать усилия.\n\n&quot;;&amp;#10;TXT_SAVING = &quot;Сохраняем ответы, это займёт несколько секунд. Пожалуйста, не закрывайте окно.&quot;;&amp;#10;TXT_SAVED = &quot;Ответы сохранены. Нажмите пробел, чтобы завершить.&quot;;&amp;#10;TXT_SAVE_FAILED = &quot;Не удалось сохранить ответы: нет связи с сервером. Проверьте подключение к интернету и нажмите R, чтобы попробовать ещё раз, или пробел, чтобы завершить.&quot;;&amp;#10;TXT_SAVE_OFF = &quot;Ответы не сохранены: эксперимент не подключён к хранилищу данных (не вписан ID DataPipe). Пожалуйста, сообщите об этом исследователю. Нажмите пробел, чтобы завершить.&quot;;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.eventManager.clearEvents();&amp;#10;hist_update('d');&amp;#10;dp_shown = '';&amp;#10;dp_send('');&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="event.clearEvents()&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="if event.getKeys(keyList=['space']):&amp;#10;    continueRoutine = False&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="var _msg = (dp_state === 'ok') ? TXT_SAVED : ((dp_state === 'failed') ? TXT_SAVE_FAILED : ((dp_state === 'off') ? TXT_SAVE_OFF : TXT_SAVING));&amp;#10;if (_msg !== dp_shown) { thanks_text.setText(TXT_THANKS_BASE + _msg); dp_shown = _msg; }&amp;#10;var _tk = psychoJS.eventManager.getKeys({keyList: ['space', 'r']});&amp;#10;if (dp_state === 'failed' &amp;&amp; _tk.indexOf('r') &gt;= 0) { dp_send(''); }&amp;#10;else if (dp_state !== 'sending' &amp;&amp; _tk.indexOf('space') &gt;= 0) { continueRoutine = false; }&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="// Отправка уже выполнена на последнем экране. Если эксперимент закрыт раньше (отладочный выход по Esc),&amp;#10;// отправляется то, что успело накопиться, с пометкой partial в имени файла.&amp;#10;if (typeof dp_send === 'function' &amp;&amp; dp_state === 'idle' &amp;&amp; psychoJS.experiment._trialsData.length &gt; 0) { dp_send('partial'); }&amp;#10;psychoJS._saveResults = 0;&amp;#10;" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_datapipe" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
  </Routines>
